# PDF Generation Configuration for Windows
# Copy these settings to your main .env file

# Chrome executable path (will be auto-detected if not set)
# PUPPETEER_CHROMIUM_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Chrome user data directory for PDF generation
CHROME_USER_DATA_DIR=%TEMP%\chrome-pdf-generation

# PDF generation timeout settings
PDF_GENERATION_TIMEOUT=120000
PDF_BROWSER_TIMEOUT=90000

# PDF generation method priority (comma-separated)
# Options: puppeteer, jsreport, html-pdf
PDF_GENERATION_METHODS=puppeteer,jsreport

# Chrome launch arguments for Windows
CHROME_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu,--disable-web-security,--single-process

# Enable PDF generation debugging
PDF_DEBUG=true

# Fallback PDF generation settings
PDF_ENABLE_FALLBACK=true
PDF_RETRY_ATTEMPTS=3
PDF_RETRY_DELAY=5000

# Windows-specific settings
WINDOWS_PDF_MODE=true
DISABLE_CHROME_SANDBOX=true
